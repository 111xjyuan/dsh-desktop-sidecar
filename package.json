{
  "name": "dsh-desktop-sidecar",
  "version": "0.9.0",
  "description": "Windows 桌面控制插件：让 AI 看屏幕、点按钮、打字。不抢你的鼠标键盘、不改你的窗口状态，你随时可以在侧边栏「指挥台」打字打断它；每步都会回头核对屏幕，做不到就说做不到。零外部运行时。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/composer.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "CHANGELOG.md",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/111xjyuan/dsh-desktop-sidecar.git"
  },
  "homepage": "https://github.com/111xjyuan/dsh-desktop-sidecar#readme",
  "bugs": {
    "url": "https://github.com/111xjyuan/dsh-desktop-sidecar/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "desktop",
    "desktop-control",
    "computer-use",
    "windows",
    "uia",
    "ocr",
    "automation",
    "rpa",
    "gui-automation"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node tests/unit.mjs && node tests/smoke.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "sync": "powershell -NoProfile -File scripts/sync.ps1",
    "test:e2e": "node tests/e2e.mjs",
    "test:all": "node tests/unit.mjs && node tests/smoke.mjs && node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  }
}
