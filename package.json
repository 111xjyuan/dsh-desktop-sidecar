{
  "name": "dsh-desktop-sidecar",
  "version": "0.6.1",
  "description": "Windows 桌面控制插件：原生看屏幕、读文字、点控件、打字、按键——微信/Office/浏览器/网课都能操作。零外部运行时（koffi 直调 Win32），离线 OCR 兜底，点击像素校验，UIA 控件树带索引点击。Native Windows desktop control for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "CHANGELOG.md",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/111xjyuan/dsh-desktop-sidecar.git"
  },
  "homepage": "https://github.com/111xjyuan/dsh-desktop-sidecar#readme",
  "bugs": {
    "url": "https://github.com/111xjyuan/dsh-desktop-sidecar/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "desktop",
    "desktop-control",
    "computer-use",
    "windows",
    "uia",
    "ocr",
    "automation",
    "rpa",
    "gui-automation"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node tests/unit.mjs && node tests/smoke.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "sync": "powershell -NoProfile -File scripts/sync.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
