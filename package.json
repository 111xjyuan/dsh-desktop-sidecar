{
  "name": "dsh-desktop-sidecar",
  "version": "0.4.5",
  "description": "DSH 桌面控制插件：让 AI 直接操作 Windows 桌面——窗口枚举、UIA 控件树、进程内 GDI 截图、离线 OCR 找字点击、UIA 调用、剪贴板输入中文、按键组合、网课自动播放。无需装驱动。Native Windows desktop control for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/111xjyuan/dsh-desktop-sidecar.git"
  },
  "homepage": "https://github.com/111xjyuan/dsh-desktop-sidecar#readme",
  "bugs": {
    "url": "https://github.com/111xjyuan/dsh-desktop-sidecar/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "desktop",
    "desktop-control",
    "computer-use",
    "windows",
    "uia",
    "ocr",
    "automation",
    "rpa",
    "gui-automation"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "sync": "powershell -NoProfile -File scripts/sync.ps1"
  }
}




